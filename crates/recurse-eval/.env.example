# OpenAI-compatible endpoint and key for the eval harness.
# Copy to `.env` (gitignored) and fill in.

# Base URL. `/chat/completions` is appended when the path is just the base.
RECURSE_LLM_ENDPOINT=https://openrouter.ai/api/v1

# Key for the endpoint above. OPENROUTER_API_KEY wins if both are set.
RECURSE_LLM_API_KEY=

# Analysis backend for the eval: `native` (pure Rust, no external process,
# the default) or an external engine. Unset falls back to the tier YAML's
# `run.backend`, then `RECURSE_BACKEND`, then the default (native).
# EVAL_BACKEND=native
